# Copy to .env.production on VPS only; never use for local Expo development.
API_DOMAIN=api.vytor.example
ACME_EMAIL=
# Generate a 64-character hex password. No whitespace or URL-special characters.
POSTGRES_PASSWORD=
POSTGRES_DB=vytor
POSTGRES_USER=vytor_admin
# Generate distinct 64-character hex values for all three passwords.
API_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
# Compose does not interpolate variables within these URLs.
DATABASE_URL=postgresql://vytor_api:API_PASSWORD@db:5432/vytor?schema=public
MIGRATION_DATABASE_URL=postgresql://vytor_migrator:MIGRATION_PASSWORD@db:5432/vytor?schema=public
# Empty keeps production registration closed. Store only SHA-256(invitation), never the code.
REGISTRATION_INVITE_CODE_SHA256=
# Exact optional HTTPS origin for a separately hosted web build; empty disables browser CORS.
WEB_ORIGIN=
# Change for every release to the exact Git commit. Retain previous image for rollback.
VYTOR_RELEASE=prepared
# Verify tags and replace with image@sha256:... before first real deployment.
NODE_IMAGE=node:22.23.3-bookworm-slim
POSTGRES_IMAGE=postgres:18.6-bookworm
CADDY_IMAGE=caddy:2.10.2-alpine

# Dedicated proxy network; choose a non-overlapping subnet and Caddy address together.
PROXY_SUBNET=172.30.50.0/24
CADDY_PROXY_IP=172.30.50.2
