generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExerciseMeasurementType {
  WEIGHT_REPS
  REPS
  DISTANCE_TIME
  TIME
  WEIGHT_DISTANCE
}

enum WeightUnit {
  KG
  LBS
}

enum DistanceUnit {
  KM
  MI
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AppTheme {
  SYSTEM
  LIGHT
  DARK
}

enum WorkoutSetType {
  WARMUP
  REGULAR
  DROP
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  displayName  String?
  avatarData   String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  xp           Int       @default(0)
  preferredWeightUnit   WeightUnit   @default(KG)
  preferredDistanceUnit DistanceUnit @default(KM)
  restSeconds            Int          @default(90)
  theme                  AppTheme     @default(SYSTEM)

  customExercises Exercise[]
  exercisePreferences ExercisePreference[]
  feedback Feedback[]
  workouts Workout[]
  workoutTemplates WorkoutTemplate[]
  sessions Session[]
  xpEvents XpEvent[]

  sentFriendRequests     FriendRequest[] @relation("requester")
  receivedFriendRequests FriendRequest[] @relation("recipient")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Exercise {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  measurementType ExerciseMeasurementType @default(WEIGHT_REPS)

  ownerId Int?
  category String?
  archived Boolean @default(false)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  preferences ExercisePreference[]

  workoutExercises         WorkoutExercise[]
  workoutTemplateExercises WorkoutTemplateExercise[]
}

model WorkoutTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  configuration Json?
  userId    Int?

  exercises WorkoutTemplateExercise[]
  workouts  Workout[]
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model WorkoutTemplateExercise {
  id         Int @id @default(autoincrement())
  templateId Int
  exerciseId Int
  order      Int

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([templateId, exerciseId])
  @@index([templateId, order])
}

model Workout {
  id         Int       @id @default(autoincrement())
  userId     Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  templateId Int?
  suspended Boolean @default(false)
  notes String @default("")
  draft Json?
  revision Int @default(0)

  user     User             @relation(fields: [userId], references: [id])
  template WorkoutTemplate? @relation(fields: [templateId], references: [id])

  exercises WorkoutExercise[]
  xpEvent   XpEvent?

  @@index([userId, startedAt])
}

model XpEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  workoutId Int      @unique
  points    Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WorkoutExercise {
  id            Int @id @default(autoincrement())
  workoutId     Int
  exerciseId    Int
  order         Int
  weightUnit    WeightUnit   @default(KG)
  distanceUnit  DistanceUnit @default(KM)
  restSeconds   Int?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  sets WorkoutSet[]

  @@unique([workoutId, exerciseId])
  @@index([workoutId, order])
}

model WorkoutSet {
  id               Int @id @default(autoincrement())
  workoutExerciseId Int
  setNumber        Int

  weight           Float?
  distance         Float?
  reps             Int?
  durationSeconds  Int?
  setType          WorkoutSetType @default(REGULAR)
  dropSetOfId      Int?

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  dropSetOf        WorkoutSet? @relation("DropSetOrigin", fields: [dropSetOfId], references: [id], onDelete: SetNull)
  dropSets         WorkoutSet[] @relation("DropSetOrigin")

  @@unique([workoutExerciseId, setNumber])
  @@index([workoutExerciseId])
  @@index([dropSetOfId])
}

model FriendRequest {
  id         Int                 @id @default(autoincrement())
  requesterId Int
  recipientId Int
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model ExercisePreference {
  userId Int
  exerciseId Int
  notes String @default("")
  restSeconds Int?
  weightUnit WeightUnit @default(KG)
  distanceUnit DistanceUnit @default(KM)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  @@id([userId, exerciseId])
}

model Feedback {
  id Int @id @default(autoincrement())
  userId Int
  message String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
