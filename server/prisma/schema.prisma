generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())

  workouts     Workout[]
}

model Workout {
  id        Int      @id @default(autoincrement())
  userId    Int
  startedAt DateTime
  endedAt   DateTime?

  user      User @relation(fields: [userId], references: [id])
}
